          <romaji>hataraku</romaji>
          <meaning>Bekerja</meaning>
        </item>
        <item>
          <kanji>起きる</kanji>
          <reading>おきる</reading>
          <romaji>okiru</romaji>
          <meaning>Bangun</meaning>
        </item>
        <item>
          <kanji>忙しい</kanji>
          <reading>いそがしい</reading>
          <romaji>isogashii</romaji>
          <meaning>Sibuk</meaning>
        </item>
      </vocabulary>
