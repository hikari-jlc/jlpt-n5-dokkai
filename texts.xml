<jlpt-n5-dokkai>
  <texts>
    <!-- Teks 1: Cuaca -->
    <text id="1">
      <title>
        <jp>天気</jp>
        <reading>てんき</reading>
        <id>Cuaca</id>
      </title>
      <content>
        <phrase>
          <segment><kanji>今日</kanji><furigana>きょう</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>天気</kanji><furigana>てんき</furigana></segment>が
        </phrase>
        <phrase>
          とても
        </phrase>
        <phrase>
          <segment><kanji>良</kanji><furigana>よ</furigana></segment>かったです。
        </phrase>
        <phrase>
          <segment><kanji>朝</kanji><furigana>あさ</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>少</kanji><furigana>すこ</furigana></segment>し
        </phrase>
        <phrase>
          <segment><kanji>寒</kanji><furigana>さむ</furigana></segment>かったですが、
        </phrase>
        <phrase>
          <segment><kanji>昼</kanji><furigana>ひる</furigana></segment>から
        </phrase>
        <phrase>
          <segment><kanji>暖</kanji><furigana>あたた</furigana></segment>かくなりました。
        </phrase>
        <phrase>
          <segment><kanji>私</kanji><furigana>わたし</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>公園</kanji><furigana>こうえん</furigana></segment>へ
        </phrase>
        <phrase>
          <segment><kanji>行</kanji><furigana>い</furigana></segment>きました。
        </phrase>
        <phrase>
          <segment><kanji>公園</kanji><furigana>こうえん</furigana></segment>では
        </phrase>
        <phrase>
          <segment><kanji>子</kanji><furigana>こ</furigana></segment>どもたちが
        </phrase>
        <phrase>
          <segment><kanji>遊</kanji><furigana>あそ</furigana></segment>んでいました。
        </phrase>
        <phrase>
          <segment><kanji>犬</kanji><furigana>いぬ</furigana></segment>も
        </phrase>
        <phrase>
          <segment><kanji>走</kanji><furigana>はし</furigana></segment>っていました。
        </phrase>
        <phrase>
          <segment><kanji>空</kanji><furigana>そら</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>青</kanji><furigana>あお</furigana></segment>くて、
        </phrase>
        <phrase>
          <segment><kanji>気持</kanji><furigana>きも</furigana></segment>ちが
        </phrase>
        <phrase>
          <segment><kanji>良</kanji><furigana>よ</furigana></segment>かったです。
        </phrase>
      </content>
      <translation>Hari ini cuacanya sangat bagus. Pagi hari sedikit dingin, tetapi siang hari menjadi hangat. Saya pergi ke taman. Di taman, anak-anak sedang bermain. Anjing juga sedang berlari. Langit biru dan perasaannya sangat menyenangkan.</translation>
      <vocabulary>
        <item>
          <word>
            <kanji>今日</kanji>
            <furigana>きょう</furigana>
          </word>
          <romaji>kyou</romaji>
          <meaning>Hari ini</meaning>
        </item>
        <item>
          <word>
            <kanji>天気</kanji>
            <furigana>てんき</furigana>
          </word>
          <romaji>tenki</romaji>
          <meaning>Cuaca</meaning>
        </item>
        <item>
          <word>
            <kanji>朝</kanji>
            <furigana>あさ</furigana>
          </word>
          <romaji>asa</romaji>
          <meaning>Pagi</meaning>
        </item>
        <item>
          <word>
            <kanji>昼</kanji>
            <furigana>ひる</furigana>
          </word>
          <romaji>hiru</romaji>
          <meaning>Siang</meaning>
        </item>
        <item>
          <word>
            <kanji>公園</kanji>
            <furigana>こうえん</furigana>
          </word>
          <romaji>kouen</romaji>
          <meaning>Taman</meaning>
        </item>
        <item>
          <word>
            <kanji>遊</kanji>
            <furigana>あそ</furigana>
            <okurigana>ぶ</okurigana>
          </word>
          <romaji>asobu</romaji>
          <meaning>Bermain</meaning>
        </item>
      </vocabulary>
    </text>

    <!-- Teks 2: Hari Libur -->
    <text id="2">
      <title>
        <jp>休みの日</jp>
        <reading>やすみのひ</reading>
        <id>Hari Libur</id>
      </title>
      <content>
        <phrase>
          <segment><kanji>昨日</kanji><furigana>きのう</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>休</kanji><furigana>やす</furigana></segment>みの
        </phrase>
        <phrase>
          <segment><kanji>日</kanji><furigana>ひ</furigana></segment>でした。
        </phrase>
        <phrase>
          <segment><kanji>私</kanji><furigana>わたし</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>友達</kanji><furigana>ともだち</furigana></segment>と
        </phrase>
        <phrase>
          <segment><kanji>映画</kanji><furigana>えいが</furigana></segment>を
        </phrase>
        <phrase>
          <segment><kanji>見</kanji><furigana>み</furigana></segment>に
        </phrase>
        <phrase>
          <segment><kanji>行</kanji><furigana>い</furigana></segment>きました。
        </phrase>
        <phrase>
          <segment><kanji>映画館</kanji><furigana>えいがかん</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>駅</kanji><furigana>えき</furigana></segment>の
        </phrase>
        <phrase>
          <segment><kanji>近</kanji><furigana>ちか</furigana></segment>くにありました。
        </phrase>
        <phrase>
          <segment><kanji>映画</kanji><furigana>えいが</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>面白</kanji><furigana>おもしろ</furigana></segment>かったです。
        </phrase>
        <phrase>
          <segment><kanji>午後</kanji><furigana>ごご</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>一緒</kanji><furigana>いっしょ</furigana></segment>に
        </phrase>
        <phrase>
          <segment><kanji>買</kanji><furigana>か</furigana></segment>い<segment><kanji>物</kanji><furigana>もの</furigana></segment>をしました。
        </phrase>
        <phrase>
          <segment><kanji>新</kanji><furigana>あたら</furigana></segment>しい
        </phrase>
        <phrase>
          <segment><kanji>靴</kanji><furigana>くつ</furigana></segment>を
        </phrase>
        <phrase>
          <segment><kanji>買</kanji><furigana>か</furigana></segment>いました。
        </phrase>
        <phrase>
          <segment><kanji>夜</kanji><furigana>よる</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>家</kanji><furigana>いえ</furigana></segment>で
        </phrase>
        <phrase>
          <segment><kanji>本</kanji><furigana>ほん</furigana></segment>を
        </phrase>
        <phrase>
          <segment><kanji>読</kanji><furigana>よ</furigana></segment>みました。
        </phrase>
        <phrase>
          とても
        </phrase>
        <phrase>
          <segment><kanji>楽</kanji><furigana>たの</furigana></segment>しかったです。
        </phrase>
      </content>
      <translation>Kemarin adalah hari libur. Saya pergi menonton film bersama teman. Bioskop berada dekat stasiun. Filmnya sangat menarik. Sore hari kami berbelanja bersama. Saya membeli sepatu baru. Malam hari saya membaca buku di rumah. Sangat menyenangkan.</translation>
      <vocabulary>
        <item>
          <word>
            <kanji>昨日</kanji>
            <furigana>きのう</furigana>
          </word>
          <romaji>kinou</romaji>
          <meaning>Kemarin</meaning>
        </item>
        <item>
          <word>
            <kanji>休</kanji>
            <furigana>やす</furigana>
            <okurigana>み</okurigana>
          </word>
          <romaji>yasumi</romaji>
          <meaning>Libur</meaning>
        </item>
        <item>
          <word>
            <kanji>映画</kanji>
            <furigana>えいが</furigana>
          </word>
          <romaji>eiga</romaji>
          <meaning>Film</meaning>
        </item>
        <item>
          <word>
            <kanji>駅</kanji>
            <furigana>えき</furigana>
          </word>
          <romaji>eki</romaji>
          <meaning>Stasiun</meaning>
        </item>
        <item>
          <word>
            <kanji>買</kanji>
            <furigana>か</furigana>
            <okurigana>い物</okurigana>
          </word>
          <romaji>kaimono</romaji>
          <meaning>Belanja</meaning>
        </item>
        <item>
          <word>
            <kanji>楽</kanji>
            <furigana>たの</furigana>
            <okurigana>しい</okurigana>
          </word>
          <romaji>tanoshii</romaji>
          <meaning>Menyenangkan</meaning>
        </item>
      </vocabulary>
    </text>

    <!-- Teks 3: Di Restoran -->
    <text id="3">
      <title>
        <jp>レストランで</jp>
        <reading>れすとらんで</reading>
        <id>Di Restoran</id>
      </title>
      <content>
        <phrase>
          <segment><kanji>昨日</kanji><furigana>きのう</furigana></segment>の
        </phrase>
        <phrase>
          <segment><kanji>夜</kanji><furigana>よる</furigana></segment>、
        </phrase>
        <phrase>
          <segment><kanji>家族</kanji><furigana>かぞく</furigana></segment>と
        </phrase>
        <phrase>
          レストランへ
        </phrase>
        <phrase>
          <segment><kanji>行</kanji><furigana>い</furigana></segment>きました。
        </phrase>
        <phrase>
          お<segment><kanji>母</kanji><furigana>かあ</furigana></segment>さんは
        </phrase>
        <phrase>
          すしを
        </phrase>
        <phrase>
          <segment><kanji>食</kanji><furigana>た</furigana></segment>べました。
        </phrase>
        <phrase>
          お<segment><kanji>父</kanji><furigana>とう</furigana></segment>さんは
        </phrase>
        <phrase>
          てんぷらを
        </phrase>
        <phrase>
          <segment><kanji>食</kanji><furigana>た</furigana></segment>べました。
        </phrase>
        <phrase>
          <segment><kanji>私</kanji><furigana>わたし</furigana></segment>は
        </phrase>
        <phrase>
          うどんを
        </phrase>
        <phrase>
          <segment><kanji>食</kanji><furigana>た</furigana></segment>べました。
        </phrase>
        <phrase>
          みんなで
        </phrase>
        <phrase>
          お<segment><kanji>茶</kanji><furigana>ちゃ</furigana></segment>を
        </phrase>
        <phrase>
          <segment><kanji>飲</kanji><furigana>の</furigana></segment>みました。
        </phrase>
        <phrase>
          ごちそうさまでした。
        </phrase>
      </content>
      <translation>Tadi malam, saya pergi ke restoran bersama keluarga. Ibu makan sushi. Ayah makan tempura. Saya makan udon. Kami semua minum teh. Terima kasih atas makanannya.</translation>
      <vocabulary>
        <item>
          <word>
            <kanji>家族</kanji>
            <furigana>かぞく</furigana>
          </word>
          <romaji>kazoku</romaji>
          <meaning>Keluarga</meaning>
        </item>
        <item>
          <word>
            <kanji>母</kanji>
            <furigana>かあ</furigana>
            <okurigana>さん</okurigana>
          </word>
          <romaji>kaasan</romaji>
          <meaning>Ibu</meaning>
        </item>
        <item>
          <word>
            <kanji>食</kanji>
            <furigana>た</furigana>
            <okurigana>べる</okurigana>
          </word>
          <romaji>taberu</romaji>
          <meaning>Makan</meaning>
        </item>
        <item>
          <word>
            <kanji>父</kanji>
            <furigana>とう</furigana>
            <okurigana>さん</okurigana>
          </word>
          <romaji>tousan</romaji>
          <meaning>Ayah</meaning>
        </item>
        <item>
          <word>
            <kanji>飲</kanji>
            <furigana>の</furigana>
            <okurigana>む</okurigana>
          </word>
          <romaji>nomu</romaji>
          <meaning>Minum</meaning>
        </item>
        <item>
          <word>
            <kanji>茶</kanji>
            <furigana>ちゃ</furigana>
          </word>
          <romaji>cha</romaji>
          <meaning>Teh</meaning>
        </item>
      </vocabulary>
    </text>

    <!-- Teks 4: Di Sekolah -->
    <text id="4">
      <title>
        <jp>学校の一日</jp>
        <reading>がっこうのいちにち</reading>
        <id>Hari di Sekolah</id>
      </title>
      <content>
        <phrase>
          <segment><kanji>私</kanji><furigana>わたし</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>毎日</kanji><furigana>まいにち</furigana></segment>
        </phrase>
        <phrase>
          <segment><kanji>学校</kanji><furigana>がっこう</furigana></segment>へ
        </phrase>
        <phrase>
          <segment><kanji>行</kanji><furigana>い</furigana></segment>きます。
        </phrase>
        <phrase>
          <segment><kanji>朝</kanji><furigana>あさ</furigana></segment><segment><kanji>八時</kanji><furigana>はちじ</furigana></segment>に
        </phrase>
        <phrase>
          <segment><kanji>家</kanji><furigana>いえ</furigana></segment>を
        </phrase>
        <phrase>
          <segment><kanji>出</kanji><furigana>で</furigana></segment>ます。
        </phrase>
        <phrase>
          <segment><kanji>電車</kanji><furigana>でんしゃ</furigana></segment>で
        </phrase>
        <phrase>
          <segment><kanji>三十分</kanji><furigana>さんじゅっぷん</furigana></segment>
        </phrase>
        <phrase>
          かかります。
        </phrase>
        <phrase>
          <segment><kanji>学校</kanji><furigana>がっこう</furigana></segment>では
        </phrase>
        <phrase>
          <segment><kanji>日本語</kanji><furigana>にほんご</furigana></segment>を
        </phrase>
        <phrase>
          <segment><kanji>勉強</kanji><furigana>べんきょう</furigana></segment>します。
        </phrase>
        <phrase>
          お<segment><kanji>昼</kanji><furigana>ひる</furigana></segment>ご<segment><kanji>飯</kanji><furigana>はん</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>学校</kanji><furigana>がっこう</furigana></segment>の
        </phrase>
        <phrase>
          <segment><kanji>食堂</kanji><furigana>しょくどう</furigana></segment>で
        </phrase>
        <phrase>
          <segment><kanji>食</kanji><furigana>た</furigana></segment>べます。
        </phrase>
        <phrase>
          <segment><kanji>午後</kanji><furigana>ごご</furigana></segment><segment><kanji>三時</kanji><furigana>さんじ</furigana></segment>に
        </phrase>
        <phrase>
          <segment><kanji>家</kanji><furigana>いえ</furigana></segment>へ
        </phrase>
        <phrase>
          <segment><kanji>帰</kanji><furigana>かえ</furigana></segment>ります。
        </phrase>
      </content>
      <translation>Saya pergi ke sekolah setiap hari. Saya berangkat dari rumah jam 8 pagi. Perjalanan dengan kereta memakan waktu 30 menit. Di sekolah, saya belajar bahasa Jepang. Makan siang saya makan di kantin sekolah. Saya pulang ke rumah jam 3 sore.</translation>
      <vocabulary>
        <item>
          <word>
            <kanji>毎日</kanji>
            <furigana>まいにち</furigana>
          </word>
          <romaji>mainichi</romaji>
          <meaning>Setiap hari</meaning>
        </item>
        <item>
          <word>
            <kanji>学校</kanji>
            <furigana>がっこう</furigana>
          </word>
          <romaji>gakkou</romaji>
          <meaning>Sekolah</meaning>
        </item>
        <item>
          <word>
            <kanji>電車</kanji>
            <furigana>でんしゃ</furigana>
          </word>
          <romaji>densha</romaji>
          <meaning>Kereta</meaning>
        </item>
        <item>
          <word>
            <kanji>勉強</kanji>
            <furigana>べんきょう</furigana>
          </word>
          <romaji>benkyou</romaji>
          <meaning>Belajar</meaning>
        </item>
        <item>
          <word>
            <kanji>帰</kanji>
            <furigana>かえ</furigana>
            <okurigana>る</okurigana>
          </word>
          <romaji>kaeru</romaji>
          <meaning>Pulang</meaning>
        </item>
      </vocabulary>
    </text>

    <!-- Teks 5: Pekerjaan Ayah -->
    <text id="5">
      <title>
        <jp>父の仕事</jp>
        <reading>ちちのしごと</reading>
        <id>Pekerjaan Ayah</id>
      </title>
      <content>
        <phrase>
          <segment><kanji>私</kanji><furigana>わたし</furigana></segment>の
        </phrase>
        <phrase>
          <segment><kanji>父</kanji><furigana>ちち</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>会社員</kanji><furigana>かいしゃいん</furigana></segment>です。
        </phrase>
        <phrase>
          <segment><kanji>大</kanji><furigana>おお</furigana></segment>きい
        </phrase>
        <phrase>
          <segment><kanji>会社</kanji><furigana>かいしゃ</furigana></segment>で
        </phrase>
        <phrase>
          <segment><kanji>働</kanji><furigana>はたら</furigana></segment>いています。
        </phrase>
        <phrase>
          <segment><kanji>毎朝</kanji><furigana>まいあさ</furigana></segment>
        </phrase>
        <phrase>
          <segment><kanji>七時</kanji><furigana>しちじ</furigana></segment>に
        </phrase>
        <phrase>
          <segment><kanji>起</kanji><furigana>お</furigana></segment>きて、
        </phrase>
        <phrase>
          <segment><kanji>八時</kanji><furigana>はちじ</furigana></segment>に
        </phrase>
        <phrase>
          <segment><kanji>家</kanji><furigana>いえ</furigana></segment>を
        </phrase>
        <phrase>
          <segment><kanji>出</kanji><furigana>で</furigana></segment>ます。
        </phrase>
        <phrase>
          <segment><kanji>仕事</kanji><furigana>しごと</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>忙</kanji><furigana>いそが</furigana></segment>しいですが、
        </phrase>
        <phrase>
          <segment><kanji>面白</kanji><furigana>おもしろ</furigana></segment>いです。
        </phrase>
        <phrase>
          <segment><kanji>夜</kanji><furigana>よる</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>遅</kanji><furigana>おそ</furigana></segment>く
        </phrase>
        <phrase>
          <segment><kanji>帰</kanji><furigana>かえ</furigana></segment>ります。
        </phrase>
        <phrase>
          <segment><kanji>父</kanji><furigana>ちち</furigana></segment>は
        </phrase>
        <phrase>
          とても
        </phrase>
        <phrase>
          <segment><kanji>優</kanji><furigana>やさ</furigana></segment>しいです。
        </phrase>
      </content>
      <translation>Ayah saya adalah karyawan kantor. Dia bekerja di perusahaan besar. Setiap pagi bangun jam 7 dan berangkat dari rumah jam 8. Pekerjaannya sibuk tapi menarik. Dia pulang larut malam. Ayah saya sangat baik hati.</translation>
      <vocabulary>
        <item>
          <word>
            <kanji>父</kanji>
            <furigana>ちち</furigana>
          </word>
          <romaji>chichi</romaji>
          <meaning>Ayah (saya)</meaning>
        </item>
        <item>
          <word>
            <kanji>会社員</kanji>
            <furigana>かいしゃいん</furigana>
          </word>
          <romaji>kaishain</romaji>
          <meaning>Karyawan</meaning>
        </item>
        <item>
          <word>
            <kanji>働</kanji>
            <furigana>はたら</furigana>
            <okurigana>く</okurigana>
          </word>
          <romaji>hataraku</romaji>
          <meaning>Bekerja</meaning>
        </item>
        <item>
          <word>
            <kanji>起</kanji>
            <furigana>お</furigana>
            <okurigana>きる</okurigana>
          </word>
          <romaji>okiru</romaji>
          <meaning>Bangun</meaning>
        </item>
        <item>
          <word>
            <kanji>忙</kanji>
            <furigana>いそが</furigana>
            <okurigana>しい</okurigana>
          </word>
          <romaji>isogashii</romaji>
          <meaning>Sibuk</meaning>
        </item>
      </vocabulary>
    </text>

    <!-- Teks 6: Hobi Saya -->
    <text id="6">
      <title>
        <jp>私の趣味</jp>
        <reading>わたしのしゅみ</reading>
        <id>Hobi Saya</id>
      </title>
      <content>
        <phrase>
          <segment><kanji>私</kanji><furigana>わたし</furigana></segment>の
        </phrase>
        <phrase>
          <segment><kanji>趣味</kanji><furigana>しゅみ</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>音楽</kanji><furigana>おんがく</furigana></segment>を
        </phrase>
        <phrase>
          <segment><kanji>聞</kanji><furigana>き</furigana></segment>くことです。
        </phrase>
        <phrase>
          <segment><kanji>特</kanji><furigana>とく</furigana></segment>に
        </phrase>
        <phrase>
          <segment><kanji>日本</kanji><furigana>にほん</furigana></segment>の
        </phrase>
        <phrase>
          <segment><kanji>歌</kanji><furigana>うた</furigana></segment>が
