  <texts>
    <!-- Teks 1: Cuaca -->
    <text id="1">
      <title>
        <jp>天気</jp>
        <reading>てんき</reading>
        <id>Cuaca</id>
      </title>
      <content>
        <phrase>
          <jp>今日は</jp>
          <reading>きょうは</reading>
        </phrase>
        <phrase>
          <jp>天気が</jp>
          <reading>てんきが</reading>
        </phrase>
        <phrase>
          <jp>とても</jp>
          <reading>とても</reading>
        </phrase>
        <phrase>
          <jp>良かったです。</jp>
          <reading>よかったです。</reading>
        </phrase>
        <phrase>
          <jp>朝は</jp>
          <reading>あさは</reading>
        </phrase>
        <phrase>
          <jp>少し</jp>
          <reading>すこし</reading>
        </phrase>
        <phrase>
          <jp>寒かったですが、</jp>
          <reading>さむかったですが、</reading>
        </phrase>
        <phrase>
          <jp>昼から</jp>
          <reading>ひるから</reading>
        </phrase>
        <phrase>
          <jp>暖かくなりました。</jp>
          <reading>あたたかくなりました。</reading>
        </phrase>
        <phrase>
          <jp>私は</jp>
          <reading>わたしは</reading>
        </phrase>
        <phrase>
          <jp>公園へ</jp>
          <reading>こうえんへ</reading>
        </phrase>
        <phrase>
          <jp>行きました。</jp>
          <reading>いきました。</reading>
        </phrase>
        <phrase>
          <jp>公園では</jp>
          <reading>こうえんでは</reading>
        </phrase>
        <phrase>
          <jp>子どもたちが</jp>
          <reading>こどもたちが</reading>
        </phrase>
        <phrase>
          <jp>遊んでいました。</jp>
          <reading>あそんでいました。</reading>
        </phrase>
        <phrase>
          <jp>犬も</jp>
          <reading>いぬも</reading>
        </phrase>
        <phrase>
          <jp>走っていました。</jp>
          <reading>はしっていました。</reading>
        </phrase>
        <phrase>
          <jp>空は</jp>
          <reading>そらは</reading>
        </phrase>
        <phrase>
          <jp>青くて、</jp>
          <reading>あおくて、</reading>
        </phrase>
        <phrase>
          <jp>気持ちが</jp>
          <reading>きもちが</reading>
        </phrase>
        <phrase>
          <jp>良かったです。</jp>
          <reading>よかったです。</reading>
        </phrase>
      </content>
      <translation>Hari ini cuacanya sangat bagus. Pagi hari sedikit dingin, tetapi siang hari menjadi hangat. Saya pergi ke taman. Di taman, anak-anak sedang bermain. Anjing juga sedang berlari. Langit biru dan perasaannya sangat menyenangkan.</translation>
      <vocabulary>
        <item>
          <kanji>今日</kanji>
          <reading>きょう</reading>
          <romaji>kyou</romaji>
          <meaning>Hari ini</meaning>
        </item>
        <item>
          <kanji>天気</kanji>
          <reading>てんき</reading>
          <romaji>tenki</romaji>
          <meaning>Cuaca</meaning>
        </item>
        <item>
          <kanji>朝</kanji>
          <reading>あさ</reading>
          <romaji>asa</romaji>
          <meaning>Pagi</meaning>
        </item>
        <item>
          <kanji>昼</kanji>
          <reading>ひる</reading>
          <romaji>hiru</romaji>
          <meaning>Siang</meaning>
        </item>
        <item>
          <kanji>公園</kanji>
          <reading>こうえん</reading>
          <romaji>kouen</romaji>
          <meaning>Taman</meaning>
        </item>
        <item>
          <kanji>遊ぶ</kanji>
          <reading>あそぶ</reading>
          <romaji>asobu</romaji>
          <meaning>Bermain</meaning>
        </item>
      </vocabulary>
    </text>

    <!-- Teks 2: Hari Libur -->
    <text id="2">
      <title>
        <jp>休みの日</jp>
        <reading>やすみのひ</reading>
        <id>Hari Libur</id>
      </title>
      <content>
        <phrase>
          <jp>昨日は</jp>
          <reading>きのうは</reading>
        </phrase>
        <phrase>
          <jp>休みの</jp>
          <reading>やすみの</reading>
        </phrase>
        <phrase>
          <jp>日でした。</jp>
          <reading>ひでした。</reading>
        </phrase>
        <phrase>
          <jp>私は</jp>
          <reading>わたしは</reading>
        </phrase>
        <phrase>
          <jp>友達と</jp>
          <reading>ともだちと</reading>
        </phrase>
        <phrase>
          <jp>映画を</jp>
          <reading>えいがを</reading>
        </phrase>
        <phrase>
          <jp>見に</jp>
          <reading>みに</reading>
        </phrase>
        <phrase>
          <jp>行きました。</jp>
          <reading>いきました。</reading>
        </phrase>
        <phrase>
          <jp>映画館は</jp>
          <reading>えいがかんは</reading>
        </phrase>
        <phrase>
          <jp>駅の</jp>
          <reading>えきの</reading>
        </phrase>
        <phrase>
          <jp>近くにありました。</jp>
          <reading>ちかくにありました。</reading>
        </phrase>
        <phrase>
          <jp>映画は</jp>
          <reading>えいがは</reading>
        </phrase>
        <phrase>
          <jp>面白かったです。</jp>
          <reading>おもしろかったです。</reading>
        </phrase>
        <phrase>
          <jp>午後は</jp>
          <reading>ごごは</reading>
        </phrase>
        <phrase>
          <jp>一緒に</jp>
          <reading>いっしょに</reading>
        </phrase>
        <phrase>
          <jp>買い物をしました。</jp>
          <reading>かいものをしました。</reading>
        </phrase>
        <phrase>
          <jp>新しい</jp>
          <reading>あたらしい</reading>
        </phrase>
        <phrase>
          <jp>靴を</jp>
          <reading>くつを</reading>
        </phrase>
        <phrase>
          <jp>買いました。</jp>
          <reading>かいました。</reading>
        </phrase>
        <phrase>
          <jp>夜は</jp>
          <reading>よるは</reading>
        </phrase>
        <phrase>
          <jp>家で</jp>
          <reading>いえで</reading>
        </phrase>
        <phrase>
          <jp>本を</jp>
          <reading>ほんを</reading>
        </phrase>
        <phrase>
          <jp>読みました。</jp>
          <reading>よみました。</reading>
        </phrase>
        <phrase>
          <jp>とても</jp>
          <reading>とても</reading>
        </phrase>
        <phrase>
          <jp>楽しかったです。</jp>
          <reading>たのしかったです。</reading>
        </phrase>
      </content>
      <translation>Kemarin adalah hari libur. Saya pergi menonton film bersama teman. Bioskop berada dekat stasiun. Filmnya sangat menarik. Sore hari kami berbelanja bersama. Saya membeli sepatu baru. Malam hari saya membaca buku di rumah. Sangat menyenangkan.</translation>
      <vocabulary>
        <item>
          <kanji>昨日</kanji>
          <reading>きのう</reading>
          <romaji>kinou</romaji>
          <meaning>Kemarin</meaning>
        </item>
        <item>
          <kanji>休み</kanji>
          <reading>やすみ</reading>
          <romaji>yasumi</romaji>
          <meaning>Libur</meaning>
        </item>
        <item>
          <kanji>映画</kanji>
          <reading>えいが</reading>
          <romaji>eiga</romaji>
          <meaning>Film</meaning>
        </item>
        <item>
          <kanji>駅</kanji>
          <reading>えき</reading>
          <romaji>eki</romaji>
          <meaning>Stasiun</meaning>
        </item>
        <item>
          <kanji>買い物</kanji>
          <reading>かいもの</reading>
          <romaji>kaimono</romaji>
          <meaning>Belanja</meaning>
        </item>
        <item>
          <kanji>楽しい</kanji>
          <reading>たのしい</reading>
          <romaji>tanoshii</romaji>
          <meaning>Menyenangkan</meaning>
        </item>
      </vocabulary>
    </text>

    <!-- Teks 3: Di Restoran -->
    <text id="3">
      <title>
        <jp>レストランで</jp>
        <reading>れすとらんで</reading>
        <id>Di Restoran</id>
      </title>
      <content>
        <phrase>
          <jp>昨日の</jp>
          <reading>きのうの</reading>
        </phrase>
        <phrase>
          <jp>夜、</jp>
          <reading>よる、</reading>
        </phrase>
        <phrase>
          <jp>家族と</jp>
          <reading>かぞくと</reading>
        </phrase>
        <phrase>
          <jp>レストランへ</jp>
          <reading>れすとらんへ</reading>
        </phrase>
        <phrase>
          <jp>行きました。</jp>
          <reading>いきました。</reading>
        </phrase>
        <phrase>
          <jp>お母さんは</jp>
          <reading>おかあさんは</reading>
        </phrase>
        <phrase>
          <jp>寿司を</jp>
          <reading>すしを</reading>
        </phrase>
        <phrase>
          <jp>食べました。</jp>
          <reading>たべました。</reading>
        </phrase>
        <phrase>
          <jp>お父さんは</jp>
          <reading>おとうさんは</reading>
        </phrase>
        <phrase>
          <jp>天ぷらを</jp>
          <reading>てんぷらを</reading>
        </phrase>
        <phrase>
          <jp>食べました。</jp>
          <reading>たべました。</reading>
        </phrase>
        <phrase>
          <jp>私は</jp>
          <reading>わたしは</reading>
        </phrase>
        <phrase>
          <jp>うどんを</jp>
          <reading>うどんを</reading>
        </phrase>
        <phrase>
          <jp>食べました。</jp>
          <reading>たべました。</reading>
        </phrase>
        <phrase>
          <jp>みんなで</jp>
          <reading>みんなで</reading>
        </phrase>
        <phrase>
          <jp>お茶を</jp>
          <reading>おちゃを</reading>
        </phrase>
        <phrase>
          <jp>飲みました。</jp>
          <reading>のみました。</reading>
        </phrase>
        <phrase>
          <jp>ごちそうさまでした。</jp>
          <reading>ごちそうさまでした。</reading>
        </phrase>
      </content>
      <translation>Tadi malam, saya pergi ke restoran bersama keluarga. Ibu makan sushi. Ayah makan tempura. Saya makan udon. Kami semua minum teh. Terima kasih atas makanannya.</translation>
      <vocabulary>
        <item>
          <kanji>家族</kanji>
          <reading>かぞく</reading>
          <romaji>kazoku</romaji>
          <meaning>Keluarga</meaning>
        </item>
        <item>
          <kanji>寿司</kanji>
          <reading>すし</reading>
          <romaji>sushi</romaji>
          <meaning>Sushi</meaning>
        </item>
        <item>
          <kanji>食べる</kanji>
          <reading>たべる</reading>
          <romaji>taberu</romaji>
          <meaning>Makan</meaning>
        </item>
        <item>
          <kanji>飲む</kanji>
          <reading>のむ</reading>
          <romaji>nomu</romaji>
          <meaning>Minum</meaning>
        </item>
        <item>
          <kanji>お茶</kanji>
          <reading>おちゃ</reading>
          <romaji>ocha</romaji>
          <meaning>Teh</meaning>
        </item>
      </vocabulary>
    </text>

    <!-- Teks 4: Di Sekolah -->
    <text id="4">
      <title>
        <jp>学校の一日</jp>
        <reading>がっこうのいちにち</reading>
        <id>Hari di Sekolah</id>
      </title>
      <content>
        <phrase>
          <jp>私は</jp>
          <reading>わたしは</reading>
        </phrase>
        <phrase>
          <jp>毎日</jp>
          <reading>まいにち</reading>
        </phrase>
        <phrase>
          <jp>学校へ</jp>
          <reading>がっこうへ</reading>
        </phrase>
        <phrase>
          <jp>行きます。</jp>
          <reading>いきます。</reading>
        </phrase>
        <phrase>
          <jp>朝八時に</jp>
          <reading>あさはちじに</reading>
        </phrase>
        <phrase>
          <jp>家を</jp>
          <reading>いえを</reading>
        </phrase>
        <phrase>
          <jp>出ます。</jp>
          <reading>でます。</reading>
        </phrase>
        <phrase>
          <jp>電車で</jp>
          <reading>でんしゃで</reading>
        </phrase>
        <phrase>
          <jp>三十分</jp>
          <reading>さんじゅっぷん</reading>
        </phrase>
        <phrase>
          <jp>かかります。</jp>
          <reading>かかります。</reading>
        </phrase>
        <phrase>
          <jp>学校では</jp>
          <reading>がっこうでは</reading>
        </phrase>
        <phrase>
          <jp>日本語を</jp>
          <reading>にほんごを</reading>
        </phrase>
        <phrase>
          <jp>勉強します。</jp>
          <reading>べんきょうします。</reading>
        </phrase>
        <phrase>
          <jp>お昼ご飯は</jp>
          <reading>おひるごはんは</reading>
        </phrase>
        <phrase>
          <jp>学校の</jp>
          <reading>がっこうの</reading>
        </phrase>
        <phrase>
          <jp>食堂で</jp>
          <reading>しょくどうで</reading>
        </phrase>
        <phrase>
          <jp>食べます。</jp>
          <reading>たべます。</reading>
        </phrase>
        <phrase>
          <jp>午後三時に</jp>
          <reading>ごごさんじに</reading>
        </phrase>
        <phrase>
          <jp>家へ</jp>
          <reading>いえへ</reading>
        </phrase>
        <phrase>
          <jp>帰ります。</jp>
          <reading>かえります。</reading>
        </phrase>
      </content>
      <translation>Saya pergi ke sekolah setiap hari. Saya berangkat dari rumah jam 8 pagi. Perjalanan dengan kereta memakan waktu 30 menit. Di sekolah, saya belajar bahasa Jepang. Makan siang saya makan di kantin sekolah. Saya pulang ke rumah jam 3 sore.</translation>
      <vocabulary>
        <item>
          <kanji>毎日</kanji>
          <reading>まいにち</reading>
          <romaji>mainichi</romaji>
          <meaning>Setiap hari</meaning>
        </item>
        <item>
          <kanji>学校</kanji>
          <reading>がっこう</reading>
          <romaji>gakkou</romaji>
          <meaning>Sekolah</meaning>
        </item>
        <item>
          <kanji>電車</kanji>
          <reading>でんしゃ</reading>
          <romaji>densha</romaji>
          <meaning>Kereta</meaning>
        </item>
        <item>
          <kanji>勉強</kanji>
          <reading>べんきょう</reading>
          <romaji>benkyou</romaji>
          <meaning>Belajar</meaning>
        </item>
        <item>
          <kanji>帰る</kanji>
          <reading>かえる</reading>
          <romaji>kaeru</romaji>
          <meaning>Pulang</meaning>
        </item>
      </vocabulary>
    </text>

    <!-- Teks 5: Pekerjaan Ayah -->
    <text id="5">
      <title>
        <jp>父の仕事</jp>
        <reading>ちちのしごと</reading>
        <id>Pekerjaan Ayah</id>
      </title>
      <content>
        <phrase>
          <jp>私の</jp>
          <reading>わたしの</reading>
        </phrase>
        <phrase>
          <jp>父は</jp>
          <reading>ちちは</reading>
        </phrase>
        <phrase>
          <jp>会社員です。</jp>
          <reading>かいしゃいんです。</reading>
        </phrase>
        <phrase>
          <jp>大きい</jp>
          <reading>おおきい</reading>
        </phrase>
        <phrase>
          <jp>会社で</jp>
          <reading>かいしゃで</reading>
        </phrase>
        <phrase>
          <jp>働いています。</jp>
          <reading>はたらいています。</reading>
        </phrase>
        <phrase>
          <jp>毎朝</jp>
          <reading>まいあさ</reading>
        </phrase>
        <phrase>
          <jp>七時に</jp>
          <reading>しちじに</reading>
        </phrase>
        <phrase>
          <jp>起きて、</jp>
          <reading>おきて、</reading>
        </phrase>
        <phrase>
          <jp>八時に</jp>
          <reading>はちじに</reading>
        </phrase>
        <phrase>
          <jp>家を</jp>
          <reading>いえを</reading>
        </phrase>
        <phrase>
          <jp>出ます。</jp>
          <reading>でます。</reading>
        </phrase>
        <phrase>
          <jp>仕事は</jp>
          <reading>しごとは</reading>
        </phrase>
        <phrase>
          <jp>忙しいですが、</jp>
          <reading>いそがしいですが、</reading>
        </phrase>
        <phrase>
          <jp>面白いです。</jp>
          <reading>おもしろいです。</reading>
        </phrase>
        <phrase>
          <jp>夜は</jp>
          <reading>よるは</reading>
        </phrase>
        <phrase>
          <jp>遅く</jp>
          <reading>おそく</reading>
        </phrase>
        <phrase>
          <jp>帰ります。</jp>
          <reading>かえります。</reading>
        </phrase>
        <phrase>
          <jp>父は</jp>
          <reading>ちちは</reading>
        </phrase>
        <phrase>
          <jp>とても</jp>
          <reading>とても</reading>
        </phrase>
        <phrase>
          <jp>優しいです。</jp>
          <reading>やさしいです。</reading>
        </phrase>
      </content>
      <translation>Ayah saya adalah karyawan kantor. Dia bekerja di perusahaan besar. Setiap pagi bangun jam 7 dan berangkat dari rumah jam 8. Pekerjaannya sibuk tapi menarik. Dia pulang larut malam. Ayah saya sangat baik hati.</translation>
