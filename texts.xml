<jlpt-n5-dokkai>
  <texts>
    <!-- Teks 1: Cuaca -->
    <text id="1">
      <title>
        <jp>天気</jp>
        <reading>てんき</reading>
        <id>Cuaca</id>
      </title>
      <content>
        <phrase>
          <segment><kanji>今日</kanji><furigana>きょう</furigana></segment>は
        </phrase>
        <phrase>
          <segment><kanji>天気</kanji><furigana>てんき</furigana></segment>がとても<segment><kanji>良</kanji><furigana>よ</furigana></segment>かったです。
        </phrase>
        <phrase>
          <segment><kanji>朝</kanji><furigana>あさ</furigana></segment>は<segment><kanji>少</kanji><furigana>すこ</furigana></segment>し<segment><kanji>寒</kanji><furigana>さむ</furigana></segment>かったですが、<segment><kanji>昼</kanji><furigana>ひる</furigana></segment>から<segment><kanji>暖</kanji><furigana>あたた</furigana></segment>かくなりました。
        </phrase>
        <phrase>
          <segment><kanji>私</kanji><furigana>わたし</furigana></segment>は<segment><kanji>公園</kanji><furigana>こうえん</furigana></segment>へ<segment><kanji>行</kanji><furigana>い</furigana></segment>きました。
        </phrase>
        <phrase>
          <segment><kanji>公園</kanji><furigana>こうえん</furigana></segment>では<segment><kanji>子</kanji><furigana>こ</furigana></segment>どもたちが<segment><kanji>遊</kanji><furigana>あそ</furigana></segment>んでいました。
        </phrase>
        <phrase>
          <segment><kanji>犬</kanji><furigana>いぬ</furigana></segment>も<segment><kanji>走</kanji><furigana>はし</furigana></segment>っていました。
        </phrase>
        <phrase>
          <segment><kanji>空</kanji><furigana>そら</furigana></segment>は<segment><kanji>青</kanji><furigana>あお</furigana></segment>くて、<segment><kanji>気持</kanji><furigana>きも</furigana></segment>ちが<segment><kanji>良</kanji><furigana>よ</furigana></segment>かったです。
        </phrase>
      </content>
      <translation>Hari ini cuacanya sangat bagus. Pagi hari sedikit dingin, tetapi siang hari menjadi hangat. Saya pergi ke taman. Di taman, anak-anak sedang bermain. Anjing juga sedang berlari. Langit biru dan perasaannya sangat menyenangkan.</translation>
      <vocabulary>
        <item>
          <word>今日</word>
          <reading>きょう</reading>
          <romaji>kyou</romaji>
          <meaning>Hari ini</meaning>
        </item>
        <item>
          <word>天気</word>
          <reading>てんき</reading>
          <romaji>tenki</romaji>
          <meaning>Cuaca</meaning>
        </item>
        <item>
          <word>朝</word>
          <reading>あさ</reading>
          <romaji>asa</romaji>
          <meaning>Pagi</meaning>
        </item>
        <item>
          <word>昼</word>
          <reading>ひる</reading>
          <romaji>hiru</romaji>
          <meaning>Siang</meaning>
        </item>
        <item>
          <word>公園</word>
          <reading>こうえん</reading>
          <romaji>kouen</romaji>
          <meaning>Taman</meaning>
        </item>
        <item>
          <word>遊ぶ</word>
          <reading>あそぶ</reading>
          <romaji>asobu</romaji>
          <meaning>Bermain</meaning>
        </item>
      </vocabulary>
    </text>

    <!-- Teks 2: Hari Libur -->
    <text id="2">
      <title>
        <jp>休みの日</jp>
        <reading>やすみのひ</reading>
        <id>Hari Libur</id>
      </title>
      <content>
        <phrase>
          <segment><kanji>昨日</kanji><furigana>きのう</furigana></segment>は<segment><kanji>休</kanji><furigana>やす</furigana></segment>みの<segment><kanji>日</kanji><furigana>ひ</furigana></segment>でした。
        </phrase>
        <phrase>
          <segment><kanji>私</kanji><furigana>わたし</furigana></segment>は<segment><kanji>友達</kanji><furigana>ともだち</furigana></segment>と<segment><kanji>映画</kanji><furigana>えいが</furigana></segment>を<segment><kanji>見</kanji><furigana>み</furigana></segment>に<segment><kanji>行</kanji><furigana>い</furigana></segment>きました。
        </phrase>
        <phrase>
          <segment><kanji>映画館</kanji><furigana>えいがかん</furigana></segment>は<segment><kanji>駅</kanji><furigana>えき</furigana></segment>の<segment><kanji>近</kanji><furigana>ちか</furigana></segment>くにありました。
        </phrase>
        <phrase>
          <segment><kanji>映画</kanji><furigana>えいが</furigana></segment>は<segment><kanji>面白</kanji><furigana>おもしろ</furigana></segment>かったです。
        </phrase>
        <phrase>
          <segment><kanji>午後</kanji><furigana>ごご</furigana></segment>は<segment><kanji>一緒</kanji><furigana>いっしょ</furigana></segment>に<segment><kanji>買</kanji><furigana>か</furigana></segment>い<segment><kanji>物</kanji><furigana>もの</furigana></segment>をしました。
        </phrase>
        <phrase>
          <segment><kanji>新</kanji><furigana>あたら</furigana></segment>しい<segment><kanji>靴</kanji><furigana>くつ</furigana></segment>を<segment><kanji>買</kanji><furigana>か</furigana></segment>いました。
        </phrase>
        <phrase>
          <segment><kanji>夜</kanji><furigana>よる</furigana></segment>は<segment><kanji>家</kanji><furigana>いえ</furigana></segment>で<segment><kanji>本</kanji><furigana>ほん</furigana></segment>を<segment><kanji>読</kanji><furigana>よ</furigana></segment>みました。
        </phrase>
        <phrase>
          とても<segment><kanji>楽</kanji><furigana>たの</furigana></segment>しかったです。
        </phrase>
      </content>
      <translation>Kemarin adalah hari libur. Saya pergi menonton film bersama teman. Bioskop berada dekat stasiun. Filmnya sangat menarik. Sore hari kami berbelanja bersama. Saya membeli sepatu baru. Malam hari saya membaca buku di rumah. Sangat menyenangkan.</translation>
      <vocabulary>
        <item>
          <word>昨日</word>
          <reading>きのう</reading>
          <romaji>kinou</romaji>
          <meaning>Kemarin</meaning>
        </item>
        <item>
          <word>休み</word>
          <reading>やすみ</reading>
          <romaji>yasumi</romaji>
          <meaning>Libur</meaning>
        </item>
        <item>
          <word>映画</word>
          <reading>えいが</reading>
          <romaji>eiga</romaji>
          <meaning>Film</meaning>
        </item>
        <item>
          <word>駅</word>
          <reading>えき</reading>
          <romaji>eki</romaji>
          <meaning>Stasiun</meaning>
        </item>
        <item>
          <word>買い物</word>
          <reading>かいもの</reading>
          <romaji>kaimono</romaji>
          <meaning>Belanja</meaning>
        </item>
        <item>
          <word>楽しい</word>
          <reading>たのしい</reading>
          <romaji>tanoshii</romaji>
          <meaning>Menyenangkan</meaning>
        </item>
      </vocabulary>
    </text>
  </texts>
